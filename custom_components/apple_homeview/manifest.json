{
  "domain": "apple_homeview",
  "name": "Apple HomeView",
  "categories": [
    "media_entertainment.speakers_audio",
    "media_entertainment.tv_streaming"
  ],
  "codeowners": ["@simplytoast1"],
  "config_flow": true,
  "dependencies": ["zeroconf", "media_source"],
  "documentation": "https://github.com/simplytoast1/ha-homeview",
  "integration_type": "device",
  "iot_class": "local_push",
  "issue_tracker": "https://github.com/simplytoast1/ha-homeview/issues",
  "loggers": ["pyatv", "srptools"],
  "requirements": ["pyatv>=0.18.0"],
  "version": "0.2.0",
  "zeroconf": [
    {
      "type": "_airplay._tcp.local.",
      "properties": {
        "model": "homeaccessory*"
      }
    }
  ]
}
